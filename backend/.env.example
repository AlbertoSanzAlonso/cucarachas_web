# Copia este archivo a backend/.env y rellena los valores.
# backend/.env está en .gitignore — no lo subas a git.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=cambia-esta-clave-en-local

# Obligatoria para agentes / migrate (se instancia al cargar URLs)
OPENAI_API_KEY=
# Mode veu Realtime (oficina): más caro por minuto que Whisper+TTS.
# OPS_REALTIME_MODEL=gpt-realtime
# OPS_REALTIME_VOICE=marin

# Opcional
# GOOGLE_API_KEY=
# AGENDA_TIMEZONE=Europe/Madrid
# AGENDA_DAYS_AHEAD=14
# AGENDA_SLOT_MINUTES=30

# Email SMTP DonDominio (citas + presupuestos + asistente oficina).
# En Coolify: obligatorias. Usuario = cuenta completa; password = la del buzón.
EMAIL_HOST=smtp.dondominio.com
EMAIL_PORT=587
EMAIL_HOST_USER=info@cucarachasbarcelona.cat
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=info@cucarachasbarcelona.cat
BOOKING_NOTIFY_EMAIL=info@cucarachasbarcelona.cat
# En local, sin password, puedes forzar consola:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# OPS_EMAIL_DRY_RUN=true

# OpenWA (WhatsApp del asistente de oficina). Misma red Docker que el contenedor.
# OPENWA_ENABLED=true
# OPENWA_API_URL=http://openwa:2785/api
# OPENWA_API_KEY=
# OPENWA_SESSION_ID=
# OPENWA_DRY_RUN=true
